PORT=3000
# Bepul/lokal: SQLite fayl. Pullik serverda: DATABASE_URL=postgres://user:pass@host:5432/ombor
SQLITE_FILE=./data/ombor.db
DATABASE_URL=
# Albatta o'zgartiring: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Reklamalarni boshqarish uchun (faqat siz bilasiz). Bo'sh bo'lsa reklama boshqaruvi o'chiq.
SUPER_KEY=
# Frontend boshqa domenda bo'lsa: https://sizning-sayt.uz (vergul bilan bir nechta). Bo'sh = hammasi.
CORS_ORIGIN=
# Render/Railway/Nginx orqasida bo'lsa 1
TRUST_PROXY=0
# --- SMS (telefon raqamni tasdiqlash va parolni tiklash uchun) ---
# eskiz   : https://eskiz.uz hisobi (ESKIZ_EMAIL, ESKIZ_PASSWORD). Matn shabloni Eskiz'da tasdiqlangan bo'lishi kerak.
# console : kod faqat server logiga yoziladi (FAQAT sinov uchun, productionda ishlatmang)
# Bo'sh qoldirilsa: ESKIZ_* bor bo'lsa eskiz; yo'q bo'lsa development'da console, production'da SMS xatosi (503).
SMS_PROVIDER=
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# {code} o'rniga 6 xonali kod qo'yiladi
SMS_TEMPLATE=Ombor tasdiqlash kodi: {code}. Uni hech kimga bermang.
# Bitta IP dan 15 daqiqada nechta SMS so'rash mumkin (SMS pul turadi)
SMS_RATE_LIMIT=10
# Butun tizim bo'yicha 24 soatda eng ko'pi bilan nechta SMS (Eskiz balansini bot hujumidan himoya qiladi). 0 = cheklovsiz
SMS_DAILY_LIMIT=300
# Sotuvchi o'z sotuvini necha daqiqa ichida bekor qila oladi (0 = faqat admin)
SELLER_VOID_MINUTES=15